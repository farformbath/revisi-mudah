{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mentorspec.org/schemas/adjudication.schema.json",
  "title": "AuthorAdjudication",
  "description": "Explicit author adjudication recording human decisions on extracted feedback items.",
  "type": "object",
  "required": ["schema", "source_ref", "feedback_ref", "author", "decisions"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "enum": ["mentorspec/1.0"]
    },
    "source_ref": {
      "type": "string",
      "description": "SHA-256 digest of original audio file.",
      "pattern": "^[a-f0-9]{64}$"
    },
    "feedback_ref": {
      "type": "string",
      "description": "Identifier or hash of the evaluated MentorFeedback artifact."
    },
    "author": {
      "type": "object",
      "required": ["adjudicated_at"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": ["string", "null"] },
        "adjudicated_at": { "type": "string", "format": "date-time" }
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["feedback_id", "decision"],
        "additionalProperties": false,
        "properties": {
          "feedback_id": {
            "type": "string",
            "pattern": "^F[0-9]+$"
          },
          "decision": {
            "type": "string",
            "enum": ["accepted", "rejected", "clarified"]
          },
          "author_notes": {
            "type": ["string", "null"],
            "description": "Author justification, constraint, or contextual note."
          },
          "clarified_action": {
            "type": ["string", "null"],
            "description": "Required if decision is clarified; specifies author-revised instruction."
          }
        }
      }
    }
  }
}
