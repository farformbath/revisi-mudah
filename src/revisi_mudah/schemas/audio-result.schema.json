{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mentorspec.org/schemas/audio-result.schema.json",
  "title": "AudioResult",
  "description": "Verbatim, immutable transcription result preserved from audio recordings.",
  "type": "object",
  "required": ["schema", "source", "transcription"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "enum": ["mentorspec/1.0"]
    },
    "source": {
      "type": "object",
      "required": ["file", "sha256", "duration_ms", "file_size_bytes", "media_type"],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "description": "Relative filename of the audio recording (no absolute paths).",
          "pattern": "^[^/\\\\]+$"
        },
        "sha256": {
          "type": "string",
          "description": "64-character lowercase hexadecimal SHA-256 digest of original audio file.",
          "pattern": "^[a-f0-9]{64}$"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Total duration in milliseconds."
        },
        "file_size_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "File size in bytes."
        },
        "media_type": {
          "type": "string",
          "description": "MIME type of the media file, e.g. audio/mp4, audio/mpeg, audio/wav.",
          "pattern": "^audio/.+"
        }
      }
    },
    "transcription": {
      "type": "object",
      "required": ["provider", "language", "segments"],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "description": "The STT engine or native multimodal provider (e.g. whisper.cpp, gemini, omp_native)."
        },
        "model": {
          "type": "string",
          "description": "Identifier of the model used."
        },
        "language": {
          "type": "string",
          "description": "BCP-47 or ISO-639-1 language code, e.g. id, en."
        },
        "segments": {
          "type": "array",
          "description": "Chronological verbatim transcript segments.",
          "items": {
            "type": "object",
            "required": ["id", "start_ms", "end_ms", "text"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^S[0-9]+$",
                "description": "Stable unique segment ID, e.g. S001, S002."
              },
              "start_ms": {
                "type": "integer",
                "minimum": 0,
                "description": "Start timestamp in milliseconds."
              },
              "end_ms": {
                "type": "integer",
                "minimum": 0,
                "description": "End timestamp in milliseconds."
              },
              "speaker": {
                "type": ["string", "null"],
                "description": "Speaker label (e.g. supervisor_1, author), or null if undetermined."
              },
              "text": {
                "type": "string",
                "description": "Verbatim transcript text of this segment."
              },
              "confidence": {
                "type": ["number", "null"],
                "minimum": 0.0,
                "maximum": 1.0,
                "description": "Confidence score if provided by engine, or null."
              }
            }
          }
        }
      }
    }
  }
}
