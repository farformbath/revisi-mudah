{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mentorspec.org/schemas/feedback.schema.json",
  "title": "MentorFeedback",
  "description": "Structured supervisor feedback extracted from audio with traceable evidence anchors.",
  "type": "object",
  "required": ["schema", "source_ref", "feedback_items"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "enum": ["mentorspec/1.0"]
    },
    "source_ref": {
      "type": "string",
      "description": "SHA-256 digest of the source audio file.",
      "pattern": "^[a-f0-9]{64}$"
    },
    "extraction_metadata": {
      "type": "object",
      "properties": {
        "extractor_model": { "type": "string" },
        "extracted_at": { "type": "string", "format": "date-time" }
      }
    },
    "feedback_items": {
      "type": "array",
      "description": "List of discrete supervisor directives and insights.",
      "items": {
        "type": "object",
        "required": ["id", "category", "type", "evidence", "action", "status"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F[0-9]+$",
            "description": "Stable unique feedback ID, e.g. F001, F002."
          },
          "category": {
            "type": "string",
            "enum": [
              "methodology",
              "theory",
              "data",
              "analysis",
              "formula",
              "citation",
              "structure",
              "editorial",
              "administrative"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "revision_request",
              "question",
              "suggestion",
              "approval",
              "administrative_instruction",
              "decision",
              "deadline"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "description": "Verbatim quote evidence linked directly to transcript segments.",
            "items": {
              "type": "object",
              "required": ["segment_id", "quote"],
              "additionalProperties": false,
              "properties": {
                "segment_id": {
                  "type": "string",
                  "pattern": "^S[0-9]+$"
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "chapter": { "type": ["string", "null"] },
              "section": { "type": ["string", "null"] }
            }
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "description": "Actionable task required to address the feedback."
          },
          "ambiguity": {
            "type": ["string", "null"],
            "description": "Explicit description of unresolved ambiguity, or null."
          },
          "status": {
            "type": "string",
            "enum": ["needs_author_review", "accepted", "rejected", "clarified"],
            "default": "needs_author_review"
          }
        }
      }
    }
  }
}
